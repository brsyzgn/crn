# Optional: enables the AI practice feature (/practice and AI feedback on interview answers).
# Without it the app works fully; AI features show a friendly "not available" message.
# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional: model used for AI practice (default: gpt-5-mini).
# OPENAI_MODEL=gpt-5-mini

# Optional: pronunciation audio. Uses OPENAI_API_KEY (server-side) for natural female speech.
# Without a key the app falls back to the best available browser voice.
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=nova
